# Configuración de la API
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_ENDPOINTS={"drivers": "/drivers", "teams": "/teams"}

# Configuración de la Aplicación
VITE_APP_TITLE=Formula 1 Dashboard
VITE_APP_ENV=development

# Tema y Estilos
VITE_THEME_COLORS={"primary": "#E10600", "secondary": "#1E1E1E"}

# Permisos del Usuario
VITE_USER_PERMISSIONS=[{"action": "read", "resource": "drivers"}]

# Configuración de Características
VITE_ENABLE_FEATURES={"liveTiming": true, "driverStats": true}

# Configuración de API Externa
VITE_F1_API_KEY=your_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key

# Configuración de Rutas
VITE_ROUTES={"home": "/", "drivers": "/drivers"}

# Configuración de Temporada Actual
VITE_CURRENT_SEASON=2024